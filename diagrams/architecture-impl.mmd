        CHR[("ChromaDB<br/>语义去重")]
        SQL[("SQLite<br/>元数据/状态")]
    end

    subgraph CRAWL["数据采集层"]
        C1["GitHub Trending"]
        C2["Hugging Face Daily"]
        C3["ArXiv AI RSS"]
    end

    C1 & C2 & C3 -->|落库| SQL
    C1 & C2 & C3 -->|向量化| CHR
