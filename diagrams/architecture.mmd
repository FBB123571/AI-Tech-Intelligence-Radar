%% npx -y @mermaid-js/mermaid-cli -i diagrams/architecture.mmd -o diagrams/architecture.png -b white

%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Microsoft YaHei, Segoe UI, Arial, sans-serif",
    "fontSize": "13px",
    "primaryColor": "#E8F1F8",
    "primaryTextColor": "#1A2B3C",
    "primaryBorderColor": "#1F4E79",
    "secondaryColor": "#E6F4F1",
    "secondaryBorderColor": "#2A7B6E",
    "tertiaryColor": "#F5F0E6",
    "tertiaryBorderColor": "#6B5B3E",
    "lineColor": "#4A6274",
    "clusterBkg": "#FFFFFF",
    "clusterBorder": "#8FA9BC",
    "titleColor": "#1F4E79",
    "background": "#FFFFFF"
  },
  "flowchart": { "curve": "basis", "padding": 20, "nodeSpacing": 24, "rankSpacing": 36, "htmlLabels": true }
}}%%

flowchart TB
    subgraph SRC["① 数据采集层"]
        direction LR
        C1["GitHub Trending"]
        C2["Hugging Face Daily"]
        C3["ArXiv AI RSS"]
    end

    subgraph SVC["② 服务与控制层 · FastAPI"]
        direction LR
        SCH["APScheduler<br/>定时调度"]
        API["REST API / Pipeline"]
    end

    subgraph DATA["③ 智能与存储层"]
        direction LR
        SQL[("SQLite<br/>元数据")]
        CHR[("ChromaDB<br/>语义去重")]
        LLM["LLM 两阶段<br/>过滤 + 结构化"]
    end

    subgraph AGT["④ Agent 流水线"]
        direction LR
        CLS["Classifier<br/>分类/标签"]
        SCR["Scorer<br/>Rubric 打分"]
        WRT["Writer<br/>周报生成"]
        CLS --> SCR --> WRT
    end

    subgraph HITL["⑤ 人机协同"]
        ED["Streamlit 看板<br/>筛选 · 复核 ≤30min"]
    end

    subgraph OUT["⑥ 交付输出"]
        direction LR
        RPT["weekly_report.md"]
        PUSH["飞书 / 邮件"]
        WEB["GitHub Pages"]
    end

    C1 & C2 & C3 --> SCH
    SCH --> API
    API --> SQL
    API --> CHR
    API --> LLM
    SQL --> CLS
    LLM --> CLS
    CHR -.-> SCR
    WRT --> RPT
    ED --> RPT
    ED --> PUSH
    RPT --> WEB
    AGT --> ED

    classDef c1 fill:#EEF2F6,stroke:#4A6274,stroke-width:1.5px,color:#1A2B3C
    classDef c2 fill:#E6F4F1,stroke:#2A7B6E,stroke-width:1.5px,color:#1A2B3C
    classDef c3 fill:#F5F0E6,stroke:#6B5B3E,stroke-width:1.5px,color:#1A2B3C
    classDef c4 fill:#F3E8EE,stroke:#7B4B6A,stroke-width:1.5px,color:#1A2B3C
    classDef c5 fill:#E8F1F8,stroke:#1F4E79,stroke-width:1.5px,color:#1A2B3C
    classDef db fill:#FFFFFF,stroke:#2A7B6E,stroke-width:2px,color:#1A2B3C

    class C1,C2,C3 c1
    class SCH,API c2
    class SQL,CHR db
    class LLM,CLS,SCR,WRT c3
    class ED c4
    class RPT,PUSH,WEB c5
