flowchart LR
    subgraph L1["① 信息源层 · P0 / P1 / P2"]
        direction TB
        S1["arXiv · cs.CL/LG/CV"]
        S2["Hugging Face"]
        S3["GitHub Trending"]
        S4["官方博客 RSS"]
        S5["Newsletter / 中文源"]
    end

    subgraph L2["② 采集层"]
        direction TB
        SCH["APScheduler<br/>日采 02:00"]
        ADP["源适配器 Adapter"]
        RAW[("raw_items")]
    end

    subgraph L3["③ 数据层"]
        direction TB
        DED["去重<br/>URL + 向量"]
        DB[("SQLite items")]
        VEC[("向量索引")]
        CFG["focus.yaml"]
    end

    subgraph L4["④ Agent 层 · LangGraph"]
        direction TB
        ORC["Orchestrator"]
        CLS["Classifier<br/>类型 / 标签"]
        SCR["Scorer<br/>Rubric 五维"]
        WRT["Writer<br/>周报段落"]
        ORC --> CLS --> SCR --> WRT
    end

    subgraph L5["⑤ 人机协同"]
        direction TB
        ED["轮值编辑复核<br/>≤ 30 min / 周"]
    end

    subgraph L6["⑥ 交付层"]
        direction TB
        RPT["weekly_report.md"]
        PUSH["飞书 / 邮件"]
        WEB["Streamlit / Pages"]
    end

    subgraph L7["⑦ 运维"]
        direction TB
        OPS1["日志 · 重试"]
        OPS2["成本统计"]
        OPS3["源失败告警"]
    end

  S1 & S2 & S3 & S4 & S5 --> ADP
  SCH --> ADP
  ADP --> RAW --> DED --> DB
  DB <--> VEC
  CFG -.-> SCR
  DB --> ORC
  WRT --> RPT --> ED
  ED --> PUSH
  ED --> WEB
  L2 -.-> L7
  L4 -.-> L7

  classDef layerSource fill:#E8F1F8,stroke:#1F4E79,stroke-width:1.5px,color:#1A2B3C
  classDef layerIngest fill:#EEF2F6,stroke:#4A6274,stroke-width:1.5px,color:#1A2B3C
  classDef layerData fill:#E6F4F1,stroke:#2A7B6E,stroke-width:1.5px,color:#1A2B3C
  classDef layerAgent fill:#F5F0E6,stroke:#6B5B3E,stroke-width:1.5px,color:#1A2B3C
  classDef layerHuman fill:#F3E8EE,stroke:#7B4B6A,stroke-width:1.5px,color:#1A2B3C
  classDef layerDeliver fill:#E8F1F8,stroke:#1F4E79,stroke-width:1.5px,color:#1A2B3C
  classDef layerOps fill:#F0F2F5,stroke:#8FA9BC,stroke-width:1px,color:#4A6274
  classDef store fill:#FFFFFF,stroke:#2A7B6E,stroke-width:2px,color:#1A2B3C

  class S1,S2,S3,S4,S5 layerSource
  class SCH,ADP layerIngest
  class DED,CFG layerData
  class RAW,DB,VEC store
  class ORC,CLS,SCR,WRT layerAgent
  class ED layerHuman
  class RPT,PUSH,WEB layerDeliver
  class OPS1,OPS2,OPS3 layerOps
